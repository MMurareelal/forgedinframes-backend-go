# Application Configuration
PORT=3002
NODE_ENV=development
GIN_MODE=debug
BACKEND_URL=http://localhost:3002
FRONTEND_URL=http://localhost:5173

# Firebase Realtime Database and Storage Configuration
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_PROJECT_ID=your-project-id

# Firebase Service Account Credential
# Option 1: File path to service account key JSON
FIREBASE_SERVICE_ACCOUNT_PATH=astute-binder-298616-firebase-adminsdk-70ikg-6e0f93afa3.json

# Option 2: Raw or Base64 JSON string
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Authentication Configuration
JWT_SECRET=forgedinframes-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=168h # 7 days (e.g., 24h, 168h)

# CORS Whitelist (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200,https://forgedinframes.netlify.app,https://forgedinframes.com

# Admin Email Addresses (comma separated)
ADMIN_EMAILS=murareelal.meghwal@gmail.com,murareelalm@gmail.com

# Google Analytics 4 (GA4) Configuration
GA4_PROPERTY_ID=your-numeric-ga4-property-id

# Security & Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_REQUESTS=150
UPLOAD_LIMIT_MAX_REQUESTS=25
MUTATION_LIMIT_MAX_REQUESTS=60
MAX_FILE_SIZE_BYTES=5242880 # 5MB
TRUST_PROXY=true
